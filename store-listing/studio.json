{
  "$schema": "https://unpkg.com/screenshot-studio/studio/schemas/studio.schema.json",
  "app": "ChangeDetection",
  "locales": [
    "en-US",
    "de-DE",
    "es-ES",
    "it-IT",
    "pt-BR",
    "hi-IN",
    "bn-BD",
    "zh-CN"
  ],
  "defaultLocale": "en-US",
  "supersample": 2,
  "capture": {
    "build": "./gradlew :shared:assembleAndroidDeviceTest -q",
    "runs": [
      {
        "options": {"palette": "BLUE", "theme": "light"},
        "profiles": [
          "phone"
        ]
      },
      {
        "options": {"palette": "BLUE", "theme": "dark"},
        "profiles": [
          "phone"
        ],
        "locales": "default"
      },
      {
        "options": {"palette": "BLUE", "theme": "light"},
        "profiles": [
          "tablet7",
          "tablet10"
        ],
        "locales": "default"
      }
    ]
  },
  "identity": {
    "icon": "../website/public/logo.png"
  },
  "frames": {
    "phone": {
      "bezel": 0.02,
      "radius": 0.09
    },
    "tablet": {
      "bezel": 0.02,
      "radius": 0.09
    },
    "landscape": {
      "bezel": 0.011,
      "radius": 0.035
    }
  },
  "bounds": {
    "layouts": {
      "turbo": {
        "top": true
      },
      "tablet10": {
        "cut": true
      }
    }
  }
}
