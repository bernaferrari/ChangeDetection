default_platform(:android)

def require_release_credentials
  ["CHANGEDETECTION_SIGNING_PROPERTIES", "CHANGEDETECTION_PLAY_CREDENTIALS"].each do |name|
    path = ENV[name]
    UI.user_error!("Set #{name} to an external credential file before publishing.") unless path && File.file?(path)
  end
end

platform :android do
  desc "Run Android quality checks"
  lane :test do
    gradle(tasks: [":composeApp:testAndroidHostTest", ":composeApp:compileAndroidDeviceTest", ":app:lintDebug", ":app:assembleDebug"])
  end

  desc "Publish a release bundle to Google Play internal testing"
  lane :internal do
    require_release_credentials
    gradle(task: ":app:bundleRelease")
    upload_to_play_store(
      track: "internal",
      mapping: "app/build/outputs/mapping/release/mapping.txt",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true, skip_upload_metadata: true,
      skip_upload_images: true, skip_upload_screenshots: true
    )
  end

  desc "Publish a release bundle to Google Play production"
  lane :deploy do
    require_release_credentials
    gradle(task: ":app:bundleRelease")
    upload_to_play_store(
      track: "production",
      mapping: "app/build/outputs/mapping/release/mapping.txt",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true, skip_upload_metadata: true,
      skip_upload_images: true, skip_upload_screenshots: true
    )
  end
end
