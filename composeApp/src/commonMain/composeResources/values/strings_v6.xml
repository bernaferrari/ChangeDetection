    <string name="editor_baseline_note">Changing what’s watched starts fresh from the next check. Your history stays, and the switch itself won’t send an alert.</string>
    <string name="editor_text_body">Reads the words on the page. Fast and light on battery. Best for prices, dates, job posts and listings.</string>
    <string name="editor_screenshot_body">Compares how the page looks. Catches images, layout and pages built with JavaScript. Slower and uses more data.</string>
    <string name="editor_source_body">Any change in the page’s source counts, including scripts and whitespace. Noisy on most sites.</string>
    <string name="editor_html_body">Compares the page’s HTML after cleanup. Catches markup changes you can’t see.</string>
