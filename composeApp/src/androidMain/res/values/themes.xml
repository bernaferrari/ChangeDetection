<?xml version="1.0" encoding="utf-8"?>

<resources>
    <!-- Matches the app's surface so a cold start does not flash a different colour. -->
    <style name="Theme.ChangeDetection" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_surface</item>
    </style>
    <color name="launch_surface">#EFECF6</color>
</resources>
