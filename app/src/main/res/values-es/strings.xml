    <!-- Onboarding -->
    <string name="onboarding_button_get_started">Comenzar</string>
    <string name="onboarding_title_welcome">Bienvenido a ChangeDetection</string>
    <string name="onboarding_description_welcome">Supervisa cualquier sitio web y recibe notificaciones instantáneas cuando el contenido importante cambie.</string>
    <string-array name="onboarding_highlights_welcome">
        <item>Monitoreo web en tiempo real</item>
        <item>Detección inteligente de cambios</item>
        <item>Notificaciones atractivas</item>
    </string-array>
    <string name="onboarding_title_element_selection">Selección inteligente de elementos</string>
    <string name="onboarding_description_element_selection">Elige elementos específicos como precios, stock o bloques de contenido con un selector visual intuitivo.</string>
    <string-array name="onboarding_highlights_element_selection">
        <item>Selector visual de elementos</item>
        <item>Enfoque inteligente del contenido</item>
        <item>Compatibilidad con autenticación</item>
    </string-array>
    <string name="onboarding_title_zap">Monitoreo sin anuncios</string>
    <string name="onboarding_description_zap">Elimina anuncios, banners y distracciones para que solo se rastree el contenido relevante.</string>
    <string-array name="onboarding_highlights_zap">
        <item>Bloqueo potente de contenido</item>
        <item>Selección de jerarquía principal</item>
        <item>Reglas de bloqueo persistentes</item>
    </string-array>
    <string name="onboarding_title_turbo">Modo turbo</string>
    <string name="onboarding_description_turbo">Activa un monitoreo de alta frecuencia para lanzamientos, ediciones limitadas o momentos donde cada segundo cuenta.</string>
    <string-array name="onboarding_highlights_turbo">
        <item>Intervalos de monitoreo de 15 segundos</item>
        <item>Programación basada en prioridad</item>
        <item>Alertas en tiempo real</item>
    </string-array>
    <string name="onboarding_title_analytics">Analíticas potentes</string>
    <string name="onboarding_description_analytics">Comprende patrones de cambio, confiabilidad y rendimiento con gráficos e insights atractivos.</string>
    <string-array name="onboarding_highlights_analytics">
        <item>Análisis de frecuencia de cambios</item>
        <item>Métricas de confiabilidad del sitio</item>
        <item>Capacidades de exportación</item>
    </string-array>
    <string name="onboarding_title_ready">Listo para comenzar</string>
    <string name="onboarding_description_ready">Añade tu primer sitio y experimenta el poder de la detección inteligente de cambios.</string>
    <string-array name="onboarding_highlights_ready">
        <item>Monitoreo de nivel empresarial</item>
        <item>Diseño moderno y agradable</item>
        <item>Notificaciones ultrarrápidas</item>
    </string-array>

